# SecondChance environment template
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Nothing in this file is required to reproduce the paper. `make all` runs
# entirely on the two committed CSVs with no credentials of any kind. Everything
# below is for the deployed AWS pipeline described in docs/02_AWS_SETUP_RUNBOOK.md.

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=secondchance

# Environment name. Every resource is suffixed with it, so dev and prod can
# coexist in one account without colliding.
ENVIRONMENT=dev
PROJECT_NAME=secondchance

# --- Buckets -----------------------------------------------------------------
# Created by the SAM template. Fill these in from the stack outputs after the
# first deploy; the account id suffix is what makes them globally unique.
RAW_BUCKET=secondchance-raw-dev-000000000000
CURATED_BUCKET=secondchance-curated-dev-000000000000
ARTIFACT_BUCKET=secondchance-artifacts-dev-000000000000

# --- Redshift Serverless -----------------------------------------------------
REDSHIFT_WORKGROUP=secondchance-dev-wg
REDSHIFT_DATABASE=secondchance

# --- API tokens --------------------------------------------------------------
# Both are optional and both improve life.
#
# Socrata works with no token at a much lower rate limit, which is fine for a
# nightly incremental pull and painful for a full backfill. Free, instant:
#   https://data.austintexas.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# RescueGroups has no anonymous tier. It is only needed for the public discovery
# page; every model number in the paper is computed without it.
#   https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=

# The National Weather Service API needs no key at all. It does reject requests
# that do not identify their caller, which is what this address is for.
NWS_USER_AGENT_CONTACT=davishiggins1@gmail.com

# --- Bedrock -----------------------------------------------------------------
# Used once, offline, to structure breed tokens. Never called at serving time.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Model governance --------------------------------------------------------
# manual or auto. Leave it manual. The paper documents a case where the automatic
# gate would have promoted a model that was better only because of the window it
# was evaluated on.
MODEL_APPROVAL_MODE=manual

# The export cutoff the labels are computed against. Changing it changes which
# horizon labels are observable, so it is configuration rather than a constant.
DATA_CUTOFF_DATE=2022-03-04

# --- Alerts ------------------------------------------------------------------
# Confirm the subscription from your inbox after the first deploy, or the
# monitoring alarms will fire into nothing.
ALERT_EMAIL=davishiggins1@gmail.com

# --- Local development -------------------------------------------------------
LOG_LEVEL=INFO
