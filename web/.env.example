# SecondChance web app — environment
#
# Both are optional. With neither set the app runs entirely on the fixtures in
# src/data/, which is the mode the demo ships in.

# Base URL of the prediction API, e.g. https://api.example.org
# Leave empty to read the bundled fixtures instead. When it is set, every
# request still falls back to the fixture on failure, and the header shows the
# "Showing sample data" chip so nobody mistakes a fallback for live data.
NEXT_PUBLIC_API_BASE_URL=

# Artificial delay in milliseconds applied to fixture reads, so the Suspense
# skeletons can be seen and reviewed. 0 in normal use.
NEXT_PUBLIC_FIXTURE_DELAY=0
