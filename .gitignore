# Raw and derived data. The raw CSVs are 40 MB and are reproducible with
# `make data`; the derived parquet files are reproducible with `make analysis`.
# Neither belongs in git, and both are regenerated byte for byte from seed 20260820.
data/raw/*.csv
data/interim/
!data/reference/

# Derived results. results/MEASURED_RESULTS.json is the one exception: it is
# committed on purpose, because the paper, the deck and the website all read
# their numbers from it and a reviewer should be able to check them without
# running a 35 minute pipeline first.
results/tables/
results/figures/
results/*.html
results/baseline_statistics.json
!results/MEASURED_RESULTS.json

# Model artefacts
*.joblib
*.pkl
models/*.tar.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/

# Testing and tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node, for the presentation builder
node_modules/
package-lock.json

# Build intermediates for the PDFs
deliverables/_html/

# Secrets. There should never be one in this repository, and .env.example is the
# documented shape rather than a real file.
.env
.env.*
!.env.example
*.pem
credentials.json
aws-config

# AWS SAM
.aws-sam/
samconfig.toml
packaged.yaml

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Submission bundle
SecondChance_project.zip
